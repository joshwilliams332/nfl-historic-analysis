	partition 'Matchup Games' = m
		mode: import
		source =
				let
				    Raw = if Text.StartsWith(DataSource, "http") then Web.Contents(DataSource & "matchup_games.csv") else File.Contents(DataSource & "matchup_games.csv"),
				    Source = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"game_id", type text}, {"season", Int64.Type}, {"week", Int64.Type}, {"gameday", type text}, {"label", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
