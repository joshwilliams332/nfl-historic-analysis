table 'Player Seasons'
	lineageTag: 842db6ef-7b41-5cc8-840c-6680db1a85bc

	measure 'Player-Seasons' =
			COUNTROWS('Player Seasons')
		formatString: #,0
		lineageTag: cb815e57-4ceb-569f-8e4e-effe91447fa4

	measure 'Season PPG' =
			DIVIDE(SUM('Player Seasons'[ppr_points]), SUM('Player Seasons'[games]))
		formatString: 0.0
		lineageTag: 6705b129-5edb-5285-8cda-94a446db0dbc

	measure 'Seasons With Next' =
			CALCULATE(COUNTROWS('Player Seasons'), 'Player Seasons'[has_next] = 1)
		formatString: #,0
		lineageTag: e65ed80c-5045-589e-b500-68b193b5b16f

	measure 'Next Season PPG' =
			CALCULATE(AVERAGE('Player Seasons'[next_ppg]), 'Player Seasons'[has_next] = 1)
		formatString: 0.0
		lineageTag: a1a4fb2d-ca84-57dc-ba81-ccdd8504f4e6

	measure 'Avg PPG Change' =
			CALCULATE(AVERAGE('Player Seasons'[ppg_change]), 'Player Seasons'[has_next] = 1)
		formatString: +0.0;-0.0;0.0
		lineageTag: 5476bad7-8878-5c65-8f75-463143dd7806

	measure '% Improved Next Season' =
			CALCULATE(AVERAGE('Player Seasons'[improved]), 'Player Seasons'[has_next] = 1)
		formatString: 0%
		lineageTag: aab10d3e-9e3b-56b0-b3a1-619a731cd79c

	measure '% Top 12 Next Season' =
			CALCULATE(AVERAGE('Player Seasons'[next_top12]), 'Player Seasons'[has_next] = 1)
		formatString: 0%
		lineageTag: 0c7c58e2-a87b-5cb8-b87a-bc45ae801659

	measure '% Top 24 Next Season' =
			CALCULATE(AVERAGE('Player Seasons'[next_top24]), 'Player Seasons'[has_next] = 1)
		formatString: 0%
		lineageTag: 9d49bd37-230f-56cc-b1cb-5d1a67017be2

	measure 'Selected Stat' =
			SELECTEDVALUE('Past Stat'[Stat], "PPG")
		lineageTag: bea6507d-aab1-5f79-acb4-c09f9cf21fd6

	measure 'Past Stat Value' =
			VAR s = [Selected Stat]
			RETURN
			    SWITCH(
			        s,
			        "PPG", AVERAGE('Player Seasons'[ppg]),
			        "Touches/G", AVERAGE('Player Seasons'[touches_pg]),
			        "Targets/G", AVERAGE('Player Seasons'[targets_pg]),
			        "TDs/G", AVERAGE('Player Seasons'[td_pg]),
			        "TD rate", AVERAGE('Player Seasons'[td_rate]),
			        "Snap share", AVERAGE('Player Seasons'[snap_pct]),
			        "Age", AVERAGE('Player Seasons'[age])
			    )
		formatString: 0.00
		lineageTag: 21a2c439-bf63-5d08-bd4a-ab4fc927e9eb

	/// Correlation between the selected stat this season and PPG the next season, over the player-seasons in the current filters.
	measure 'Past Future r' =
			VAR s = [Selected Stat]
			VAR pts =
			    FILTER(
			        SELECTCOLUMNS(
			            FILTER('Player Seasons', 'Player Seasons'[has_next] = 1),
			            "x", SWITCH(
			                s,
			                "PPG", 'Player Seasons'[ppg],
			                "Touches/G", 'Player Seasons'[touches_pg],
			                "Targets/G", 'Player Seasons'[targets_pg],
			                "TDs/G", 'Player Seasons'[td_pg],
			                "TD rate", 'Player Seasons'[td_rate],
			                "Snap share", 'Player Seasons'[snap_pct],
			                "Age", 'Player Seasons'[age]
			            ),
			            "y", 'Player Seasons'[next_ppg]
			        ),
			        NOT ISBLANK([x])
			    )
			VAR n = COUNTROWS(pts)
			VAR mx = AVERAGEX(pts, [x])
			VAR my = AVERAGEX(pts, [y])
			VAR sxy = SUMX(pts, ([x] - mx) * ([y] - my))
			VAR sxx = SUMX(pts, ([x] - mx) ^ 2)
			VAR syy = SUMX(pts, ([y] - my) ^ 2)
			RETURN
			    IF(n >= 10, DIVIDE(sxy, SQRT(sxx * syy)))
		formatString: 0.00
		lineageTag: 0b71a4f6-5481-5f42-a0cd-67f97e8b4ffd

	measure 'Link Strength' =
			VAR r = [Past Future r]
			VAR a = ABS(r)
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(r), "Not enough seasons",
			        a >= 0.6, "Strong link",
			        a >= 0.4, "Moderate link",
			        a >= 0.2, "Weak link",
			        "Almost no link"
			    )
		lineageTag: d9ed6fbb-8d79-51f1-bd1c-1b952ff0bb46

	/// r squared: share of the differences in next-season PPG that the selected stat lines up with.
	measure 'Share Explained' =
			VAR r = [Past Future r]
			RETURN
			    IF(NOT ISBLANK(r), r * r)
		formatString: 0%
		lineageTag: bedf6b19-59de-5183-bbaf-4516164b9946

	measure 'Point Label' =
			SELECTEDVALUE('Player Seasons'[player]) & " " & SELECTEDVALUE('Player Seasons'[season])
		lineageTag: d1ea6d0b-0b16-5bae-bdb5-c6eb88c29a75

	/// Share of the season's top-150 PPR scorers' points that came from this position.
	measure 'Top-150 Share' =
			DIVIDE(
			    CALCULATE(SUM('Player Seasons'[ppr_points]), 'Player Seasons'[top150] = 1),
			    CALCULATE(SUM('Player Seasons'[ppr_points]), 'Player Seasons'[top150] = 1, REMOVEFILTERS('Positions'))
			)
		formatString: 0%
		lineageTag: cce5a8df-f781-5127-88d6-d46235790b92

	measure '300-Carry RBs' =
			CALCULATE(
			    COUNTROWS('Player Seasons'),
			    'Player Seasons'[carries] >= 300,
			    'Player Seasons'[position] = "RB",
			    REMOVEFILTERS('Positions')
			) + 0
		formatString: 0
		lineageTag: d39ee955-991f-5652-98d0-9699a5a63ddb

	/// Average change in PPG from this season to the next, for players with 8+ games in both (needs 20+ players).
	measure 'Aging Step' =
			VAR pairs =
			    CALCULATETABLE(
			        'Player Seasons',
			        'Player Seasons'[has_next] = 1,
			        'Player Seasons'[games] >= 8,
			        'Player Seasons'[next_games] >= 8
			    )
			RETURN
			    IF(COUNTROWS(pairs) >= 20, AVERAGEX(pairs, 'Player Seasons'[ppg_change]))
		formatString: +0.0;-0.0;0.0
		lineageTag: 653226b7-f628-516f-8dbe-9a9db36ba74b

	measure 'Career PPG' =
			CALCULATE([Season PPG], REMOVEFILTERS('Seasons'), 'Player Seasons'[is_complete] = 1)
		formatString: 0.0
		lineageTag: de55a892-536a-5aad-a6c0-c8f36d9d46d6

	measure 'Best Season PPG' =
			CALCULATE(MAX('Player Seasons'[ppg]), REMOVEFILTERS('Seasons'), 'Player Seasons'[games] >= 6)
		formatString: 0.0
		lineageTag: 7e0231b4-df78-56b0-aacf-f4f388fef9b3

	measure 'Seasons Played' =
			CALCULATE(DISTINCTCOUNT('Player Seasons'[season]), REMOVEFILTERS('Seasons'))
		formatString: 0
		lineageTag: 6f46b3a2-6246-5d1d-a7b6-4accde2e0177

	measure 'Top-24 Average at Position' =
			VAR pos = CALCULATE(SELECTEDVALUE('Player Seasons'[position]), REMOVEFILTERS('Seasons'))
			RETURN
			    IF(
			        NOT ISBLANK(pos) && NOT ISBLANK([Season PPG]),
			        CALCULATE([Season PPG], REMOVEFILTERS('Player Seasons'), 'Player Seasons'[position] = pos, 'Player Seasons'[pos_rank] <= 24)
			    )
		formatString: 0.0
		lineageTag: 82aed562-151c-5bb0-b0f5-a5a41381a0c8

	measure '2026 Projection' =
			AVERAGE('Player Seasons'[proj_next_ppg])
		formatString: 0.0
		lineageTag: b9ad13de-fccd-5af6-836f-5a730fd3182a

	measure '2026 So Far' =
			AVERAGE('Player Seasons'[current_ppg])
		formatString: 0.0
		lineageTag: 4fe56432-2dd5-57be-a185-1cc5228f83ec

	measure '2026 Games' =
			MAX('Player Seasons'[current_games])
		formatString: 0
		lineageTag: 901191d9-b5c8-591f-8aba-b584c29c1b39

	measure '2026 Projected Change' =
			[2026 Projection] - AVERAGE('Player Seasons'[ppg])
		formatString: +0.0;-0.0;0.0
		lineageTag: 490d8aa5-fb5d-5bfa-adf4-7e046a565384

