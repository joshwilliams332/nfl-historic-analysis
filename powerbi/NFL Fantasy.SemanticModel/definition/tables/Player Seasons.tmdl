	partition 'Player Seasons' = m
		mode: import
		source =
				let
				    Raw = if Text.StartsWith(DataSource, "http") then Web.Contents(DataSource & "player_seasons.csv") else File.Contents(DataSource & "player_seasons.csv"),
				    Source = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"key", type text}, {"player_id", type text}, {"player", type text}, {"player_label", type text}, {"position", type text}, {"season", Int64.Type}, {"team", type text}, {"age", type number}, {"age_years", Int64.Type}, {"games", Int64.Type}, {"ppr_points", type number}, {"ppg", type number}, {"targets_pg", type number}, {"carries_pg", type number}, {"receptions_pg", type number}, {"touches_pg", type number}, {"tds", Int64.Type}, {"td_pg", type number}, {"td_rate", type number}, {"attempts_pg", type number}, {"target_share", type number}, {"snap_pct", type number}, {"carries", type number}, {"pos_rank", Int64.Type}, {"top150", Int64.Type}, {"is_complete", Int64.Type}, {"has_next", Int64.Type}, {"next_ppg", type number}, {"next_games", type number}, {"next_pos_rank", type number}, {"ppg_change", type number}, {"improved", type number}, {"next_top12", type number}, {"next_top24", type number}, {"proj_next_ppg", type number}, {"current_ppg", type number}, {"current_games", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
