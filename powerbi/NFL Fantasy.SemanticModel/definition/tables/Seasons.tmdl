	partition Seasons = m
		mode: import
		source =
				let
				    Raw = if Text.StartsWith(DataSource, "http") then Web.Contents(DataSource & "seasons.csv") else File.Contents(DataSource & "seasons.csv"),
				    Source = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"season", Int64.Type}, {"era", type text}, {"is_complete", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
