	partition Receivers = m
		mode: import
		source =
				let
				    Raw = if Text.StartsWith(DataSource, "http") then Web.Contents(DataSource & "receivers.csv") else File.Contents(DataSource & "receivers.csv"),
				    Source = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"receiver_id", type text}, {"receiver", type text}, {"receiver_label", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
