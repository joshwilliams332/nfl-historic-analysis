table 'CB Games'
	lineageTag: a027e35c-a77a-50e0-bfdb-1b86c2ea1665

	measure 'CB Tgts' =
			SUM('CB Games'[targets])
		formatString: #,0
		lineageTag: 8c97d6a2-dfa8-5036-9a59-b7061d0b98be

	measure 'Completions Allowed' =
			SUM('CB Games'[completions])
		formatString: #,0
		lineageTag: 1ab6e69e-9f84-5198-8866-fd3dade72790

	measure 'Catch % Allowed' =
			DIVIDE([Completions Allowed], [CB Tgts])
		formatString: 0.0%
		lineageTag: 9eccf5dd-dc0a-5551-81e5-1d1b049b0c94

	measure 'Yards Allowed' =
			SUM('CB Games'[yards])
		formatString: #,0
		lineageTag: e964be98-71fe-5a2f-b10a-82484819f2f7

	measure 'Yards per Target Allowed' =
			DIVIDE([Yards Allowed], [CB Tgts])
		formatString: 0.0
		lineageTag: e4bdebe6-3192-50a3-a06a-7c20ee1ced79

	measure 'TDs Allowed' =
			SUM('CB Games'[tds])
		formatString: 0
		lineageTag: bddd538b-2dbe-508a-8fbb-333ee20b548c

	measure INTs =
			SUM('CB Games'[ints])
		formatString: 0
		lineageTag: 87c6a90b-b71e-54b3-a11f-f1d73e550e13

	/// Pro Football Reference passer rating on throws into this corner's coverage, weighted by targets.
	measure 'Passer Rating Allowed' =
			DIVIDE(SUMX('CB Games', 'CB Games'[rating] * 'CB Games'[targets]), [CB Tgts])
		formatString: 0.0
		lineageTag: 5581831c-c489-500c-924f-cc26ee673bab

	measure 'Min CB Targets Value' =
			MIN('Min CB Targets'[Value])
		formatString: 0
		lineageTag: 25f2ca9c-e840-5250-98a2-45103d28dca2

	measure 'CB Metric Value' =
			VAR m = SELECTEDVALUE('CB Metric'[Metric], "Yards allowed")
			VAR v =
			    SWITCH(
			        m,
			        "Yards allowed", [Yards Allowed],
			        "Yards/target allowed", [Yards per Target Allowed],
			        "Catch % allowed", [Catch % Allowed] * 100,
			        "Passer rating allowed", [Passer Rating Allowed],
			        "Targets", [CB Tgts],
			        "TDs allowed", [TDs Allowed]
			    )
			RETURN
			    IF([CB Tgts] > 0 && [CB Tgts] >= [Min CB Targets Value], v)
		formatString: #,0.0
		lineageTag: fe63ca59-6a95-54b8-9e98-513c5ba1f2c9

