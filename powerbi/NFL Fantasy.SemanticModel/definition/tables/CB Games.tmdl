	partition 'CB Games' = m
		mode: import
		source =
				let
				    Raw = if Text.StartsWith(DataSource, "http") then Web.Contents(DataSource & "cb_games.csv") else File.Contents(DataSource & "cb_games.csv"),
				    Source = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"game_id", type text}, {"defense", type text}, {"offense", type text}, {"cb_id", type text}, {"cb", type text}, {"listed_as", type text}, {"side", type text}, {"targets", Int64.Type}, {"completions", Int64.Type}, {"yards", type number}, {"tds", type number}, {"ints", Int64.Type}, {"rating", type number}, {"adot", type number}, {"yac", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
