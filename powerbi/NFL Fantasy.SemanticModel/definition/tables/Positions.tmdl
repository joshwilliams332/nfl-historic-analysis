	partition Positions = m
		mode: import
		source =
				let
				    Raw = if Text.StartsWith(DataSource, "http") then Web.Contents(DataSource & "positions.csv") else File.Contents(DataSource & "positions.csv"),
				    Source = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"position", type text}, {"sort_order", Int64.Type}, {"position_name", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
