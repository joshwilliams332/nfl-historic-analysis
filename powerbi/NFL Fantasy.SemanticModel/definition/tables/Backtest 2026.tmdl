	partition 'Backtest 2026' = m
		mode: import
		source =
				let
				    Raw = if Text.StartsWith(DataSource, "http") then Web.Contents(DataSource & "backtest_2026.csv") else File.Contents(DataSource & "backtest_2026.csv"),
				    Source = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"season", Int64.Type}, {"week", Int64.Type}, {"player_games", Int64.Type}, {"model_start_sit", type number}, {"season_avg_start_sit", type number}, {"model_mae", type number}, {"season_avg_mae", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
