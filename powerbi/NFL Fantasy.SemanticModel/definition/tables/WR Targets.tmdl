table 'WR Targets'
	lineageTag: 40c711fb-a3b9-560c-92b1-57f121b45d48

	measure 'WR Tgts' =
			COUNTROWS('WR Targets')
		formatString: #,0
		lineageTag: 73e2e291-d65b-50dd-bfe4-1542df808286

	measure Receptions =
			SUM('WR Targets'[complete])
		formatString: #,0
		lineageTag: b3c83455-5934-56c5-aa47-857efb7e1819

	measure 'Catch Rate' =
			DIVIDE([Receptions], [WR Tgts])
		formatString: 0.0%
		lineageTag: 6df7c5de-dba7-5101-9189-eda1a60311ea

	measure 'Receiving Yards' =
			SUM('WR Targets'[yards])
		formatString: #,0
		lineageTag: 8eac73b1-9e0a-5352-9460-8daf485b24c8

	measure 'Yards per Target' =
			DIVIDE([Receiving Yards], [WR Tgts])
		formatString: 0.0
		lineageTag: fd56596f-c01d-5242-93a5-df9291a2a777

	/// Share of targets where the play added expected points (nflverse success = EPA > 0).
	measure 'Success Rate' =
			AVERAGE('WR Targets'[success])
		formatString: 0.0%
		lineageTag: 2a182db2-33ac-551f-b4b7-28b5a20ac6f8

	measure 'Receiving TDs' =
			SUM('WR Targets'[td])
		formatString: 0
		lineageTag: ab22dce2-02eb-5707-8e91-0ae0365083a7

	/// Next Gen Stats average separation at the catch point or incompletion, weighted by targets. Not split by side of field.
	measure 'Avg Separation' =
			DIVIDE(SUMX('WR Games', 'WR Games'[avg_separation] * 'WR Games'[targets]), SUM('WR Games'[targets]))
		formatString: 0.00
		lineageTag: 433da93c-4311-5e4d-aa35-14ce2544f537

	measure 'Min WR Targets Value' =
			MIN('Min WR Targets'[Value])
		formatString: 0
		lineageTag: 91e60151-fea4-57b7-9ad3-e560d29d5e1e

	measure 'WR Metric Value' =
			VAR m = SELECTEDVALUE('WR Metric'[Metric], "Success rate %")
			VAR v =
			    SWITCH(
			        m,
			        "Success rate %", [Success Rate] * 100,
			        "Receiving yards", [Receiving Yards],
			        "Yards per target", [Yards per Target],
			        "Catch rate %", [Catch Rate] * 100,
			        "Targets", [WR Tgts],
			        "Separation (yds)", [Avg Separation]
			    )
			RETURN
			    IF([WR Tgts] > 0 && [WR Tgts] >= [Min WR Targets Value], v)
		formatString: #,0.0
		lineageTag: 4e750890-0149-566a-af60-aad770cd1bc8

