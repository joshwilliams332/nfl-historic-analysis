	partition 'WR Targets' = m
		mode: import
		source =
				let
				    Raw = if Text.StartsWith(DataSource, "http") then Web.Contents(DataSource & "wr_targets.csv") else File.Contents(DataSource & "wr_targets.csv"),
				    Source = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"game_id", type text}, {"offense", type text}, {"defense", type text}, {"receiver_id", type text}, {"receiver", type text}, {"side", type text}, {"air_yards", type number}, {"complete", Int64.Type}, {"yards", type number}, {"td", Int64.Type}, {"interception", Int64.Type}, {"success", type number}, {"epa", type number}, {"est_cb", type text}, {"est_cb_slot", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
